<Window x:Class="RFQ_Compiler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RFQ_Compiler" d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="450" Width="800">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Grid>
        <DockPanel VerticalAlignment="Top">
        <ToolBar VerticalAlignment="Top">
            <Button Content="File" MinWidth="50">
                <Button.ContextMenu>
                    <ContextMenu Name="cm" Opened="Menu_OnOpened" Closed="Menu_OnClosed" StaysOpen="true">
                        <MenuItem Header="Open" />
                        <MenuItem Header="Save" />
                        <MenuItem Header="SaveAs" />
                        <MenuItem Header="Recent Files" DataContext="{Binding RecentFiles}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </ToolBar>
        </DockPanel>
        <DockPanel Margin="0,27,0,22">
            <Label Content="Welcome to RFQ Compiler!" />
        </DockPanel>
        <DockPanel VerticalAlignment="Bottom">
            <StatusBar DockPanel.Dock="Bottom">
                <StatusBarItem VerticalAlignment="Center">
                    <TextBlock Text="Status: Ready" />
                </StatusBarItem>
            </StatusBar>
        </DockPanel>
    </Grid>
</Window>
