<Window x:Class="RFQ_Compiler.UserSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RFQ_Compiler" d:DataContext="{d:DesignInstance Type=local:LocalSettings}"
        mc:Ignorable="d"
        Title="UserSettings" Height="450" Width="800" Loaded="Window_Loaded">
    <TabControl>
        <TabItem Header="General" IsSelected="True">
            <Grid>
                <WrapPanel Margin="10" Orientation="Vertical">
                    <CheckBox VerticalAlignment="Center" Margin="0,0,5,0" Content="Registered to open SolidWorks Assembly" IsChecked="{Binding IsRegisteredCommand}" />
                    <Label Margin="20,0,0,0" Content="> Generate Package with RFQ Compiler" HorizontalAlignment="Center" FontSize="8" Foreground="#FF5A5A5A" />
                </WrapPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Pdm">
        </TabItem>
    </TabControl>
</Window>
